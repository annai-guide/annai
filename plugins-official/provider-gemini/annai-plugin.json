{
  "id": "provider-gemini",
  "name": "Google Gemini",
  "version": "2.2.0",
  "api": 1,
  "description": "Gemini models through Google's own API, with Google Search on a paid key, its transcription and voices, and Gemini Live for a voice conversation.",
  "category": "providers",
  "requires": [
    {
      "id": "gemini-api",
      "version": "^0"
    }
  ],
  "provider": {
    "baseUrl": "https://generativelanguage.googleapis.com",
    "key": "required",
    "keyUrl": "https://aistudio.google.com/apikey",
    "freeTier": "Google",
    "note": "Uses Gemini's own API. AI Studio shows each key's tier: a free key's requests are limited per minute and per day. Add more models with Fetch model list.",
    "abilities": {
      "chat": {
        "kind": "chat",
        "type": "gemini",
        "noWindowNote": "Since version 2.0 this goes through Gemini's own API, not its OpenAI-compatible endpoint. A model without a context window here was added before then, or by id: if it doesn't answer, remove it and add it again with Fetch model list.",
        "models": [
          {
            "providerId": "gemini-3.8-flash",
            "name": "Gemini 3.8 Flash",
            "input": [
              "text",
              "image",
              "pdf",
              "audio"
            ],
            "contextWindow": 1048576,
            "maxOutput": 65536,
            "reasoning": {
              "low": {
                "generation_config": {
                  "thinking_level": "low"
                }
              },
              "medium": {
                "generation_config": {
                  "thinking_level": "medium"
                }
              },
              "high": {
                "generation_config": {
                  "thinking_level": "high"
                }
              },
              "max": {
                "generation_config": {
                  "thinking_level": "high"
                }
              }
            },
            "prices": {
              "input": 0.75,
              "output": 3.75,
              "cacheRead": 0.075
            },
            "providerTools": [
              {
                "id": "gemini-google-search",
                "name": "Google Search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "google_search"
                    }
                  ]
                },
                "pricePerCall": 0.014,
                "usageKey": "google_search",
                "paidOnly": true,
                "freePerMonth": 5000,
                "label": "Let Gemini search Google",
                "note": "Google gives 5,000 searches a month free on paid projects, then $14 per 1,000: annai counts this phone's. Google keeps searched prompts for 30 days, which annai can't delete."
              }
            ]
          },
          {
            "providerId": "gemini-3.6-flash",
            "name": "Gemini 3.6 Flash",
            "input": [
              "text",
              "image",
              "pdf",
              "audio"
            ],
            "contextWindow": 1048576,
            "maxOutput": 65536,
            "reasoning": {
              "off": {
                "generation_config": {
                  "thinking_level": "minimal"
                }
              },
              "low": {
                "generation_config": {
                  "thinking_level": "low"
                }
              },
              "medium": {
                "generation_config": {
                  "thinking_level": "medium"
                }
              },
              "high": {
                "generation_config": {
                  "thinking_level": "high"
                }
              },
              "max": {
                "generation_config": {
                  "thinking_level": "high"
                }
              }
            },
            "prices": {
              "input": 0.75,
              "output": 3.75,
              "cacheRead": 0.075
            },
            "providerTools": [
              {
                "id": "gemini-google-search",
                "name": "Google Search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "google_search"
                    }
                  ]
                },
                "pricePerCall": 0.014,
                "usageKey": "google_search",
                "paidOnly": true,
                "freePerMonth": 5000,
                "label": "Let Gemini search Google",
                "note": "Google gives 5,000 searches a month free on paid projects, then $14 per 1,000: annai counts this phone's. Google keeps searched prompts for 30 days, which annai can't delete."
              }
            ]
          },
          {
            "providerId": "gemini-3.5-flash-lite",
            "name": "Gemini 3.5 Flash Lite",
            "input": [
              "text",
              "image",
              "pdf",
              "audio"
            ],
            "contextWindow": 1048576,
            "maxOutput": 65536,
            "reasoning": {
              "off": {
                "generation_config": {
                  "thinking_level": "minimal"
                }
              },
              "low": {
                "generation_config": {
                  "thinking_level": "low"
                }
              },
              "medium": {
                "generation_config": {
                  "thinking_level": "medium"
                }
              },
              "high": {
                "generation_config": {
                  "thinking_level": "high"
                }
              },
              "max": {
                "generation_config": {
                  "thinking_level": "high"
                }
              }
            },
            "prices": {
              "input": 0.3,
              "output": 2.5,
              "cacheRead": 0.03
            },
            "providerTools": [
              {
                "id": "gemini-google-search",
                "name": "Google Search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "google_search"
                    }
                  ]
                },
                "pricePerCall": 0.014,
                "usageKey": "google_search",
                "paidOnly": true,
                "freePerMonth": 5000,
                "label": "Let Gemini search Google",
                "note": "Google gives 5,000 searches a month free on paid projects, then $14 per 1,000: annai counts this phone's. Google keeps searched prompts for 30 days, which annai can't delete."
              }
            ]
          }
        ]
      },
      "transcription": {
        "kind": "transcription",
        "type": "gemini-transcription",
        "note": "Turns what you say into text, for a model that doesn't take audio. Gemini 3.5 Transcribe is Google's own; Flash Lite writes it down when asked, for less. Their prices are estimates from Google's rates for audio, about 25 tokens a second.",
        "models": [
          {
            "providerId": "gemini-3.5-transcribe",
            "name": "Gemini 3.5 Transcribe",
            "prices": {
              "perMinute": 0.005
            }
          },
          {
            "providerId": "gemini-3.5-flash-lite",
            "name": "Gemini 3.5 Flash Lite (transcription)",
            "prices": {
              "perMinute": 0.0009
            }
          }
        ]
      },
      "voice": {
        "kind": "voice",
        "type": "gemini-speech",
        "note": "Shiori's voice, a sentence at a time, each sentence one request. It streams: she starts about half a second after a sentence is written, and on a weak connection she waits until it won't stutter. Switch streaming off to have each sentence arrive whole, as other voices do. On the free tier Google allows each of these voices only 10 requests a day and 3 a minute: far fewer than a day of replies, so after the first few sentences the next voice in the list speaks. Prices are estimates per character from Google's rate for audio, 25 tokens a second.",
        "models": [
          {
            "providerId": "gemini-3.8-flash-lite-tts",
            "name": "Gemini 3.8 Flash Lite TTS",
            "prices": {
              "perMillionChars": 10
            }
          },
          {
            "providerId": "gemini-3.8-flash-tts",
            "name": "Gemini 3.8 Flash TTS",
            "prices": {
              "perMillionChars": 15
            }
          }
        ]
      },
      "live": {
        "kind": "realtime",
        "type": "gemini-live",
        "name": "Live voice",
        "on": false,
        "baseUrl": "https://generativelanguage.googleapis.com",
        "note": "A conversation in one stream, voice both ways, for Koe (Gemini Live). While a session is open, what you say goes to Google as audio. Free on AI Studio's free tier.",
        "models": [
          {
            "providerId": "gemini-3.8-live",
            "input": [
              "text",
              "image"
            ],
            "name": "Gemini 3.8 Live",
            "contextWindow": 131072,
            "prices": {
              "input": 0.75,
              "audioIn": 3,
              "image": 1,
              "output": 4.5,
              "audioOut": 12
            }
          },
          {
            "providerId": "gemini-3.8-live-extended-thinking",
            "input": [
              "text",
              "image"
            ],
            "name": "Gemini 3.8 Live Extended Thinking",
            "contextWindow": 131072,
            "prices": {
              "input": 0.75,
              "audioIn": 3,
              "image": 1,
              "output": 4.5,
              "audioOut": 12
            }
          }
        ]
      }
    },
    "roles": {
      "recommended": {
        "main": [
          "gemini-3.8-flash",
          "gemini-3.6-flash",
          "gemini-3.5-flash-lite"
        ],
        "utility": [
          "gemini-3.5-flash-lite"
        ],
        "decide": [
          "gemini-3.5-flash-lite"
        ],
        "koe": [
          "gemini-3.8-live",
          "gemini-3.5-flash-lite"
        ],
        "speech-in": [
          "gemini-3.5-transcribe",
          "gemini-3.5-flash-lite"
        ],
        "speech-out": [
          "gemini-3.8-flash-lite-tts",
          "gemini-3.8-flash-tts"
        ]
      }
    }
  }
}
