{
  "id": "provider-gemini",
  "name": "Google Gemini",
  "version": "1.3.0",
  "api": 1,
  "description": "Gemini models through Google's OpenAI-compatible endpoint, and Gemini Live for a voice conversation.",
  "category": "providers",
  "requires": [
    {
      "id": "chat-completions",
      "version": "^0"
    }
  ],
  "provider": {
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
    "key": "required",
    "keyUrl": "https://aistudio.google.com/apikey",
    "note": "Uses Gemini's OpenAI-compatible endpoint. Add models with Fetch model list.",
    "abilities": {
      "chat": {
        "kind": "chat",
        "type": "chat-completions",
        "tunables": {
          "standInCallExtra": {
            "google": {
              "thought_signature": "skip_thought_signature_validator"
            }
          },
          "audioIn": [
            "wav",
            "mp3"
          ]
        }
      },
      "live": {
        "kind": "realtime",
        "type": "gemini-live",
        "name": "Live voice",
        "on": false,
        "baseUrl": "https://generativelanguage.googleapis.com",
        "note": "A conversation in one stream, voice both ways, for Koe for talking (Gemini Live). While a session is open, what you say goes to Google as audio. Free on AI Studio's free tier.",
        "models": [
          {
            "providerId": "gemini-3.8-live",
            "name": "Gemini 3.8 Live",
            "contextWindow": 131072,
            "prices": {
              "input": 0.75,
              "audioIn": 3,
              "image": 1,
              "output": 4.5,
              "audioOut": 12
            }
          },
          {
            "providerId": "gemini-3.8-live-extended-thinking",
            "name": "Gemini 3.8 Live Extended Thinking",
            "contextWindow": 131072,
            "prices": {
              "input": 0.75,
              "audioIn": 3,
              "image": 1,
              "output": 4.5,
              "audioOut": 12
            }
          }
        ]
      }
    },
    "roles": {
      "recommended": {
        "koe-talk": [
          "gemini-3.8-live"
        ]
      }
    }
  }
}
