{
  "id": "provider-deepseek",
  "name": "DeepSeek",
  "version": "1.1.1",
  "api": 1,
  "l10n": ["ja", "zh-Hans", "zh-Hant"],
  "description": "DeepSeek's models, with their reasoning shown as they think.",
  "category": "providers",
  "requires": [
    {
      "id": "chat-completions",
      "version": "^0"
    }
  ],
  "provider": {
    "baseUrl": "https://api.deepseek.com",
    "key": "required",
    "keyUrl": "https://platform.deepseek.com/api_keys",
    "abilities": {
      "chat": {
        "kind": "chat",
        "type": "chat-completions",
        "tunables": {
          "reasoningField": "reasoning_content"
        },
        "note": "Add models with Fetch model list."
      }
    }
  }
}
