{
  "id": "provider-anthropic",
  "name": "Anthropic",
  "version": "1.2.1",
  "api": 1,
  "description": "Claude models through Anthropic's Messages API, with web search, and a cache that can last an hour.",
  "category": "providers",
  "requires": [
    {
      "id": "anthropic-messages",
      "version": "^0"
