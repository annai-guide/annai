{
  "id": "provider-openrouter",
  "name": "OpenRouter",
  "version": "2.0.0",
  "api": 1,
  "entry": "index.js",
  "description": "One key for many models, free ones among them, with transcription and voices too. Sign in with OpenRouter, or give a key.",
  "featured": "Sign in with OpenRouter is the quickest way, and it starts you on free models.",
  "category": "providers",
  "requires": [
    {
      "id": "chat-completions",
      "version": "^0"
    },
    {
      "id": "speech-openai",
      "version": "^0"
    }
  ],
  "provider": {
    "baseUrl": "https://openrouter.ai/api/v1",
    "key": "required",
    "keyUrl": "https://openrouter.ai/settings/keys",
    "headers": {
      "HTTP-Referer": "https://annai.guide",
      "X-Title": "annai"
    },
    "note": "One key for many providers. Free models allow 50 requests a day (1,000 a day after $10 of credits). Its transcription and voices use the same key: none of the transcription models is free, and Fish Audio's free voice uses one of the free requests a day for each sentence it says. The others need credits you buy at OpenRouter.",
    "abilities": {
      "chat": {
        "kind": "chat",
        "type": "chat-completions",
        "tunables": {
          "reasoningField": "reasoning",
          "audioIn": [
            "ogg",
            "aac",
            "mp4",
            "mp3",
            "flac",
            "wav"
          ]
        },
        "modelDefaults": {
          "providerTools": [
            {
              "id": "openrouter-web-search",
              "name": "OpenRouter web search",
              "kind": "search",
              "patch": {
                "tools+": [
                  {
                    "type": "openrouter:web_search"
                  }
                ]
              },
              "usageKey": "web_search_requests"
            }
          ]
        },
        "models": [
          {
            "providerId": "anthropic/claude-sonnet-5.5",
            "name": "Anthropic: Claude Sonnet 5.5",
            "contextWindow": 1000000,
            "maxOutput": 128000,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "images": {
              "formats": [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
              ],
              "maxEdge": 8000,
              "maxBytes": 5242880,
              "maxCount": 100
            },
            "providerTools": [
              {
                "id": "openrouter-web-search",
                "name": "OpenRouter web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "openrouter:web_search"
                    }
                  ]
                },
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 2,
              "output": 10,
              "cacheRead": 0.1,
              "cacheWrite": 2.5,
              "cacheWrite1h": 4
            },
            "reasoning": {
              "low": {
                "reasoning": {
                  "effort": "low"
                }
              },
              "medium": {
                "reasoning": {
                  "effort": "medium"
                }
              },
              "high": {
                "reasoning": {
                  "effort": "high"
                }
              }
            }
          },
          {
            "providerId": "anthropic/claude-haiku-5.5",
            "name": "Anthropic: Claude Haiku 5.5",
            "contextWindow": 1000000,
            "maxOutput": 128000,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "images": {
              "formats": [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
              ],
              "maxEdge": 8000,
              "maxBytes": 5242880,
              "maxCount": 100
            },
            "providerTools": [
              {
                "id": "openrouter-web-search",
                "name": "OpenRouter web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "openrouter:web_search"
                    }
                  ]
                },
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 0.1,
              "output": 0.5,
              "cacheRead": 0.01,
              "cacheWrite": 0.125,
              "cacheWrite1h": 0.2,
              "tiers": [
                {
                  "above": 99999,
                  "input": 0.5,
                  "output": 2.5,
                  "cacheRead": 0.05,
                  "cacheWrite": 0.625,
                  "cacheWrite1h": 1
                }
              ]
            },
            "reasoning": {
              "off": {
                "reasoning": {
                  "effort": "none"
                }
              },
              "low": {
                "reasoning": {
                  "effort": "low"
                }
              },
              "medium": {
                "reasoning": {
                  "effort": "medium"
                }
              },
              "high": {
                "reasoning": {
                  "effort": "high"
                }
              }
            }
          },
          {
            "providerId": "anthropic/claude-opus-5.5",
            "name": "Anthropic: Claude Opus 5.5",
            "contextWindow": 1000000,
            "maxOutput": 128000,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "images": {
              "formats": [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
              ],
              "maxEdge": 8000,
              "maxBytes": 5242880,
              "maxCount": 100
            },
            "providerTools": [
              {
                "id": "openrouter-web-search",
                "name": "OpenRouter web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "openrouter:web_search"
                    }
                  ]
                },
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 4,
              "output": 20,
              "cacheRead": 0.2,
              "cacheWrite": 5,
              "cacheWrite1h": 8
            },
            "reasoning": {
              "low": {
                "reasoning": {
                  "effort": "low"
                }
              },
              "medium": {
                "reasoning": {
                  "effort": "medium"
                }
              },
              "high": {
                "reasoning": {
                  "effort": "high"
                }
              }
            }
          },
          {
            "providerId": "google/gemma-4-31b-it:free",
            "name": "Google: Gemma 4 31B (free)",
            "contextWindow": 262144,
            "maxOutput": 32768,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "providerTools": [
              {
                "id": "openrouter-web-search",
                "name": "OpenRouter web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "openrouter:web_search"
                    }
                  ]
                },
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 0,
              "output": 0
            }
          },
          {
            "providerId": "google/gemma-4-26b-a4b-it:free",
            "name": "Google: Gemma 4 26B A4B (free)",
            "contextWindow": 262144,
            "maxOutput": 32768,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "providerTools": [
              {
                "id": "openrouter-web-search",
                "name": "OpenRouter web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "openrouter:web_search"
                    }
                  ]
                },
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 0,
              "output": 0
            }
          }
        ]
      },
      "transcription": {
        "kind": "transcription",
        "type": "openai-transcription",
        "tunables": {
          "listPath": "/models?output_modalities=transcription"
        },
        "note": "Turns what you say into text, for models that don't take audio. The prices are OpenRouter's lowest; it may send a request to a provider that charges more.",
        "models": [
          {
            "providerId": "openai/whisper-large-v3-turbo",
            "name": "OpenAI: Whisper Large V3 Turbo",
            "prices": {
              "perMinute": 0.0002
            }
          },
          {
            "providerId": "openai/whisper-large-v3",
            "name": "OpenAI: Whisper Large V3",
            "prices": {
              "perMinute": 0.00045
            }
          },
          {
            "providerId": "x-ai/grok-stt-1.0",
            "name": "SpaceXAI: Grok STT 1.0",
            "prices": {
              "perMinute": 0.00167
            }
          },
          {
            "providerId": "mistralai/voxtral-mini-transcribe",
            "name": "Mistral: Voxtral Mini Transcribe",
            "prices": {
              "perMinute": 0.003
            }
          }
        ]
      },
      "voice": {
        "kind": "voice",
        "type": "openai-speech",
        "tunables": {
          "listPath": "/models?output_modalities=speech",
          "audioOut": [
            "mp3"
          ]
        },
        "note": "Shiori's voice. Each model has voices of its own, listed on its page at openrouter.ai: put one in the model's Voice. Fish Audio's free voice speaks with its default voice. OpenRouter sends MP3 or PCM only.",
        "models": [
          {
            "providerId": "fish-audio/s2.1-pro-free:free",
            "name": "Fish Audio: S2.1 Pro Free (free)",
            "tunables": {
              "voice": ""
            },
            "prices": {
              "perMillionChars": 0
            }
          },
          {
            "providerId": "x-ai/grok-voice-tts-1.0",
            "name": "SpaceXAI: Grok Voice TTS 1.0 (Ara)",
            "tunables": {
              "voice": "ara"
            },
            "prices": {
              "perMillionChars": 15
            }
          },
          {
            "providerId": "mistralai/voxtral-mini-tts-2603",
            "name": "Mistral: Voxtral Mini TTS (Jane)",
            "tunables": {
              "voice": "gb_jane_neutral"
            },
            "prices": {
              "perMillionChars": 16
            }
          },
          {
            "providerId": "hexgrad/kokoro-82m",
            "name": "hexgrad: Kokoro 82M (Heart, English)",
            "tunables": {
              "voice": "af_heart"
            },
            "prices": {
              "perMillionChars": 0.62
            }
          }
        ]
      }
    },
    "roles": {
      "free": {
        "main": [
          "google/gemma-4-31b-it:free"
        ],
        "utility": [
          "google/gemma-4-26b-a4b-it:free"
        ],
        "decide": [
          "google/gemma-4-26b-a4b-it:free"
        ]
      },
      "recommended": {
        "main": [
          "anthropic/claude-sonnet-5.5"
        ],
        "utility": [
          "anthropic/claude-haiku-5.5"
        ],
        "decide": [
          "anthropic/claude-haiku-5.5"
        ],
        "speech-in": [
          "openai/whisper-large-v3-turbo"
        ],
        "speech-out": [
          "fish-audio/s2.1-pro-free:free",
          "x-ai/grok-voice-tts-1.0"
        ]
      }
    }
  }
}
