      "transcription": {
        "kind": "transcription",
        "type": "openai-transcription",
        "tunables": {
          "listPath": "/models?output_modalities=transcription"
        },
        "note": "Turns what you say into text, for models that don't take audio. The prices are OpenRouter's lowest; it may send a request to a provider that charges more.",
