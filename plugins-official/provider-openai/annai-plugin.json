{
  "id": "provider-openai",
  "name": "OpenAI",
  "version": "1.0.0",
  "api": 1,
  "description": "GPT models through OpenAI's Responses API, with OpenAI's transcription and voices, on one key.",
  "category": "providers",
  "requires": [
    {
      "id": "openai-responses",
      "version": "^0"
    },
    {
      "id": "speech-openai",
      "version": "^0"
    }
  ],
  "provider": {
    "baseUrl": "https://api.openai.com/v1",
    "key": "required",
    "keyUrl": "https://platform.openai.com/api-keys",
    "abilities": {
      "chat": {
        "kind": "chat",
        "type": "openai-responses",
        "name": "Chat (Responses)",
        "note": "The one to use for OpenAI: GPT-6 Astra and GPT-6.1 Sol call tools only through Responses. Reasoning summaries may need a verified organization at OpenAI; without one, add \"reasoningSummary\": false to the tunables. A reasoning model added with Fetch model list needs its Reasoning levels set, as these models have; without them it thinks without showing progress, and may run past the time limit.",
        "models": [
          {
            "providerId": "gpt-6-astra",
            "name": "GPT-6 Astra",
            "contextWindow": 922000,
            "maxOutput": 128000,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "images": {
              "formats": [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
              ],
              "maxEdge": 5000,
              "maxBytes": 20000000,
              "maxCount": 1500
            },
            "providerTools": [
              {
                "id": "openai-web-search",
                "name": "OpenAI web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "web_search"
                    }
                  ]
                },
                "pricePerCall": 0.01,
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 10,
              "output": 50,
              "cacheRead": 1,
              "cacheWrite": 12.5,
              "tiers": [
                {
                  "above": 272000,
                  "input": 20,
                  "output": 75,
                  "cacheRead": 2,
                  "cacheWrite": 25
                }
              ]
            },
            "reasoning": {
              "low": {
                "reasoning": {
                  "effort": "low"
                }
              },
              "medium": {
                "reasoning": {
                  "effort": "medium"
                }
              },
              "high": {
                "reasoning": {
                  "effort": "high"
                }
              },
              "max": {
                "reasoning": {
                  "effort": "max"
                }
              }
            }
          },
          {
            "providerId": "gpt-6.1-sol",
            "name": "GPT-6.1 Sol",
            "contextWindow": 922000,
            "maxOutput": 128000,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "images": {
              "formats": [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
              ],
              "maxEdge": 5000,
              "maxBytes": 20000000,
              "maxCount": 1500
            },
            "providerTools": [
              {
                "id": "openai-web-search",
                "name": "OpenAI web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "web_search"
                    }
                  ]
                },
                "pricePerCall": 0.01,
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 2,
              "output": 10,
              "cacheRead": 0.1,
              "cacheWrite": 2.5,
              "tiers": [
                {
                  "above": 272000,
                  "input": 4,
                  "output": 15,
                  "cacheRead": 0.2,
                  "cacheWrite": 5
                }
              ]
            },
            "reasoning": {
              "low": {
                "reasoning": {
                  "effort": "low"
                }
              },
              "medium": {
                "reasoning": {
                  "effort": "medium"
                }
              },
              "high": {
                "reasoning": {
                  "effort": "high"
                }
              },
              "max": {
                "reasoning": {
                  "effort": "max"
                }
              }
            }
          },
          {
            "providerId": "gpt-6-luna",
            "name": "GPT-6 Luna",
            "contextWindow": 922000,
            "maxOutput": 128000,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "images": {
              "formats": [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
              ],
              "maxEdge": 5000,
              "maxBytes": 20000000,
              "maxCount": 1500
            },
            "providerTools": [
              {
                "id": "openai-web-search",
                "name": "OpenAI web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "web_search"
                    }
                  ]
                },
                "pricePerCall": 0.01,
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 0.1,
              "output": 0.5,
              "cacheRead": 0.01,
              "cacheWrite": 0.125,
              "tiers": [
                {
                  "above": 272000,
                  "input": 0.2,
                  "output": 0.75,
                  "cacheRead": 0.02,
                  "cacheWrite": 0.25
                }
              ]
            },
            "reasoning": {
              "off": {
                "reasoning": {
                  "effort": "none"
                }
              },
              "low": {
                "reasoning": {
                  "effort": "low"
                }
              },
              "medium": {
                "reasoning": {
                  "effort": "medium"
                }
              },
              "high": {
                "reasoning": {
                  "effort": "high"
                }
              },
              "max": {
                "reasoning": {
                  "effort": "max"
                }
              }
            }
          }
        ]
      },
      "chat-completions": {
        "kind": "chat",
        "type": "chat-completions",
        "name": "Chat (Chat Completions)",
        "on": false,
        "tunables": {
          "maxTokensField": "max_completion_tokens",
          "systemRole": "developer"
        },
        "note": "Prefer Chat (Responses): GPT-6 Astra and GPT-6.1 Sol call tools only there. Add models with Fetch model list."
      },
      "transcription": {
        "kind": "transcription",
        "type": "openai-transcription",
        "note": "Turns what you say into text, for models that don't take audio.",
        "models": [
          {
            "providerId": "gpt-transcribe",
            "name": "OpenAI: GPT Transcribe",
            "prices": {
              "perMinute": 0.0045
            }
          },
          {
            "providerId": "gpt-4o-mini-transcribe",
            "name": "OpenAI: GPT-4o mini Transcribe",
            "prices": {
              "perMinute": 0.003
            }
          },
          {
            "providerId": "whisper-1",
            "name": "OpenAI: Whisper",
            "prices": {
              "perMinute": 0.006
            }
          }
        ]
      },
      "voice": {
        "kind": "voice",
        "type": "openai-speech",
        "note": "Shiori's voice. GPT-4o mini TTS is priced by audio; its price here is OpenAI's estimate of $0.015 a minute.",
        "models": [
          {
            "providerId": "gpt-4o-mini-tts",
            "name": "OpenAI: GPT-4o mini TTS (Marin)",
            "tunables": {
              "voice": "marin"
            },
            "prices": {
              "perMillionChars": 18
            }
          },
          {
            "providerId": "tts-1",
            "name": "OpenAI: TTS-1 (Nova)",
            "tunables": {
              "voice": "nova"
            },
            "prices": {
              "perMillionChars": 15
            }
          },
          {
            "providerId": "tts-1-hd",
            "name": "OpenAI: TTS-1 HD (Nova)",
            "tunables": {
              "voice": "nova"
            },
            "prices": {
              "perMillionChars": 30
            }
          }
        ]
      }
    },
    "roles": {
      "recommended": {
        "main": [
          "gpt-6.1-sol"
        ],
        "utility": [
          "gpt-6-luna"
        ],
        "decide": [
          "gpt-6-luna"
        ],
        "speech-in": [
          "gpt-transcribe"
        ],
        "speech-out": [
          "gpt-4o-mini-tts"
        ]
      }
    }
  }
}
