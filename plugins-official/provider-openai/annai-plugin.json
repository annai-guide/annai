{
  "id": "provider-openai",
  "name": "OpenAI",
  "version": "1.5.0",
  "api": 1,
  "description": "GPT models through OpenAI's Responses API, with OpenAI's transcription and voices, and its Realtime voice for Koe, on one key.",
  "category": "providers",
  "requires": [
    {
      "id": "openai-responses",
      "version": "^0"
    },
    {
      "id": "speech-openai",
      "version": "^0"
    }
  ],
  "provider": {
    "baseUrl": "https://api.openai.com/v1",
    "key": "required",
    "keyUrl": "https://platform.openai.com/api-keys",
    "abilities": {
      "chat": {
        "kind": "chat",
        "type": "openai-responses",
        "name": "Chat (Responses)",
        "tunables": { "keep": true },
        "note": "The one to use for OpenAI: GPT-6 Astra and GPT-6.1 Sol call tools only through Responses. Reasoning summaries may need a verified organization at OpenAI; without one, add \"reasoningSummary\": false to the tunables. A reasoning model added with Fetch model list needs its Reasoning levels set, as these models have; without them it thinks without showing progress, and may run past the time limit.",
        "models": [
          {
            "providerId": "gpt-6-astra",
            "name": "GPT-6 Astra",
            "contextWindow": 922000,
            "maxOutput": 128000,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "images": {
              "formats": [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
              ],
              "maxEdge": 5000,
              "maxBytes": 20000000,
              "maxCount": 1500
            },
            "providerTools": [
              {
                "id": "openai-web-search",
                "name": "OpenAI web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "web_search"
                    }
                  ]
                },
                "pricePerCall": 0.01,
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 10,
              "output": 50,
              "cacheRead": 1,
              "cacheWrite": 12.5,
              "tiers": [
                {
                  "above": 272000,
                  "input": 20,
                  "output": 75,
                  "cacheRead": 2,
                  "cacheWrite": 25
                }
              ]
            },
            "reasoning": {
              "low": {
                "reasoning": {
                  "effort": "low"
                }
              },
              "medium": {
                "reasoning": {
                  "effort": "medium"
                }
              },
              "high": {
                "reasoning": {
                  "effort": "high"
                }
              },
              "max": {
                "reasoning": {
                  "effort": "max"
                }
              }
            }
          },
          {
            "providerId": "gpt-6.1-sol",
            "name": "GPT-6.1 Sol",
            "contextWindow": 922000,
            "maxOutput": 128000,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "images": {
              "formats": [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
              ],
              "maxEdge": 5000,
              "maxBytes": 20000000,
              "maxCount": 1500
            },
            "providerTools": [
              {
                "id": "openai-web-search",
                "name": "OpenAI web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "web_search"
                    }
                  ]
                },
                "pricePerCall": 0.01,
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 2,
              "output": 10,
              "cacheRead": 0.1,
              "cacheWrite": 2.5,
              "tiers": [
                {
                  "above": 272000,
                  "input": 4,
                  "output": 15,
                  "cacheRead": 0.2,
                  "cacheWrite": 5
                }
              ]
            },
            "reasoning": {
              "low": {
                "reasoning": {
                  "effort": "low"
                }
              },
              "medium": {
                "reasoning": {
                  "effort": "medium"
                }
              },
              "high": {
                "reasoning": {
                  "effort": "high"
                }
              },
              "max": {
                "reasoning": {
                  "effort": "max"
                }
              }
            }
          },
          {
            "providerId": "gpt-6-luna",
            "name": "GPT-6 Luna",
            "contextWindow": 922000,
            "maxOutput": 128000,
            "input": [
              "text",
              "image"
            ],
            "tools": true,
            "images": {
              "formats": [
                "image/jpeg",
                "image/png",
                "image/gif",
                "image/webp"
              ],
              "maxEdge": 5000,
              "maxBytes": 20000000,
              "maxCount": 1500
            },
            "providerTools": [
              {
                "id": "openai-web-search",
                "name": "OpenAI web search",
                "kind": "search",
                "patch": {
                  "tools+": [
                    {
                      "type": "web_search"
                    }
                  ]
                },
                "pricePerCall": 0.01,
                "usageKey": "web_search_requests"
              }
            ],
            "prices": {
              "input": 0.1,
              "output": 0.5,
              "cacheRead": 0.01,
              "cacheWrite": 0.125,
              "tiers": [
                {
                  "above": 272000,
                  "input": 0.2,
                  "output": 0.75,
                  "cacheRead": 0.02,
                  "cacheWrite": 0.25
                }
              ]
            },
            "reasoning": {
              "off": {
                "reasoning": {
                  "effort": "none"
                }
              },
              "low": {
                "reasoning": {
                  "effort": "low"
                }
              },
              "medium": {
                "reasoning": {
                  "effort": "medium"
                }
              },
              "high": {
                "reasoning": {
                  "effort": "high"
                }
              },
              "max": {
                "reasoning": {
                  "effort": "max"
                }
              }
            }
          }
        ]
      },
      "chat-completions": {
        "kind": "chat",
        "type": "chat-completions",
        "name": "Chat (Chat Completions)",
        "on": false,
        "tunables": {
          "maxTokensField": "max_completion_tokens",
          "systemRole": "developer"
        },
        "note": "Prefer Chat (Responses): GPT-6 Astra and GPT-6.1 Sol call tools only there. Add models with Fetch model list."
      },
      "transcription": {
        "kind": "transcription",
        "type": "openai-transcription",
        "note": "Turns what you say into text, for models that don't take audio.",
        "models": [
          {
            "providerId": "gpt-transcribe",
            "name": "OpenAI: GPT Transcribe",
            "prices": {
              "perMinute": 0.0045
            }
          },
          {
            "providerId": "gpt-4o-mini-transcribe",
            "name": "OpenAI: GPT-4o mini Transcribe",
            "prices": {
              "perMinute": 0.003
            }
          },
          {
            "providerId": "whisper-1",
            "name": "OpenAI: Whisper",
            "prices": {
              "perMinute": 0.006
            }
          }
        ]
      },
      "voice": {
        "kind": "voice",
        "type": "openai-speech",
        "note": "Shiori's voice. GPT-4o mini TTS is priced by audio; its price here is OpenAI's estimate of $0.015 a minute. It takes a Style (OpenAI's instructions); TTS-1 and TTS-1 HD don't, and say nothing of one. OpenAI is retiring all three on January 6, 2027.",
        "models": [
          {
            "providerId": "gpt-4o-mini-tts",
            "name": "OpenAI: GPT-4o mini TTS (Marin)",
            "tunables": {
              "voice": "marin",
              "style": "Speak in a young, cheerful and lively, yet calm and gentle tone.",
              "voices": [
                "alloy",
                "ash",
                "ballad",
                "coral",
                "echo",
                "fable",
                "nova",
                "onyx",
                "sage",
                "shimmer",
                "verse",
                "marin",
                "cedar"
              ]
            },
            "prices": {
              "perMillionChars": 18
            }
          },
          {
            "providerId": "tts-1",
            "name": "OpenAI: TTS-1 (Nova)",
            "tunables": {
              "voice": "nova",
              "styled": false,
              "voices": [
                "alloy",
                "ash",
                "coral",
                "echo",
                "fable",
                "onyx",
                "nova",
                "sage",
                "shimmer"
              ]
            },
            "prices": {
              "perMillionChars": 15
            }
          },
          {
            "providerId": "tts-1-hd",
            "name": "OpenAI: TTS-1 HD (Nova)",
            "tunables": {
              "voice": "nova",
              "styled": false,
              "voices": [
                "alloy",
                "ash",
                "coral",
                "echo",
                "fable",
                "onyx",
                "nova",
                "sage",
                "shimmer"
              ]
            },
            "prices": {
              "perMillionChars": 30
            }
          }
        ]
      },
      "realtime": {
        "kind": "realtime",
        "type": "openai-realtime",
        "name": "Realtime voice",
        "on": false,
        "note": "A conversation in one stream, voice both ways, for Koe (OpenAI Realtime). While a session is open, what you say goes to OpenAI as telephone audio (G.711, a sixth of the data of full quality; \"input\": \"pcm16\" in the tunables sends full quality), and gpt-transcribe writes it down, which OpenAI bills apart (about $0.0045 a minute) and Spend per day doesn't count. annai gives your key to OpenAI straight from the browser, where OpenAI suggests short-lived keys made by a server: if Test says the key was rejected, or the address can't be reached, while chat works with the same key, OpenAI is refusing keys from a browser, and its realtime voice would need a server, which annai doesn't have.",
        "models": [
          {
            "providerId": "gpt-realtime-2.1",
            "name": "GPT Realtime 2.1",
            "contextWindow": 128000,
            "maxOutput": 32000,
            "input": [
              "text",
              "image"
            ],
            "images": {
              "formats": [
                "image/jpeg",
                "image/png"
              ]
            },
            "prices": {
              "input": 4,
              "cacheRead": 0.4,
              "audioIn": 32,
              "cacheReadAudio": 0.4,
              "image": 5,
              "cacheReadImage": 0.5,
              "output": 24,
              "audioOut": 64
            }
          },
          {
            "providerId": "gpt-realtime-2.1-mini",
            "name": "GPT Realtime 2.1 mini",
            "contextWindow": 128000,
            "maxOutput": 32000,
            "input": [
              "text",
              "image"
            ],
            "images": {
              "formats": [
                "image/jpeg",
                "image/png"
              ]
            },
            "prices": {
              "input": 0.6,
              "cacheRead": 0.06,
              "audioIn": 10,
              "cacheReadAudio": 0.3,
              "image": 0.8,
              "cacheReadImage": 0.08,
              "output": 2.4,
              "audioOut": 20
            }
          }
        ]
      }
    },
    "roles": {
      "recommended": {
        "main": [
          "gpt-6.1-sol"
        ],
        "utility": [
          "gpt-6-luna"
        ],
        "decide": [
          "gpt-6-luna"
        ],
        "speech-in": [
          "gpt-transcribe"
        ],
        "speech-out": [
          "gpt-4o-mini-tts"
        ]
      }
    }
  }
}
