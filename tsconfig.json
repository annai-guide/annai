{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "plugins-official/**/*.js", "scripts/**/*.mjs", "relay/**/*.js", "relay/**/*.mjs", "playwright.config.js"],
  "exclude": ["node_modules", "plugins-official/*/vendor/**"]
}
